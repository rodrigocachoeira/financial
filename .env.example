# Copy to .env. The defaults below match the local Docker database (compose.yaml)
# and are throwaway values. Never commit a .env with real credentials.

# Local: Postgres from Docker. Production: Neon pooled connection string, set in Vercel.
DATABASE_URL=postgresql://financial:financial@localhost:5432/financial

# Separate database used only by `yarn test:db`. Its name must end with "_test".
TEST_DATABASE_URL=postgresql://financial:financial@localhost:5432/financial_test

# Used only by migrations. Leave unset locally; in Vercel, the Neon direct (non-pooled) connection string.
# DIRECT_URL=

# Auth.js. Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth client (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed to sign in.
AUTH_ALLOWED_EMAIL=
