/// Normalized merchant or counterparty. Its category is the default for new transactions.
model Merchant {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Normalized by the statement reader (trimmed, single spaces, upper case).
  name       String   @unique
  categoryId String?  @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([categoryId])
  @@map("merchants")
}

model Category {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String   @unique
  /// Hex color for badges and charts.
  color            String
  /// False for money that only changes place (transfers between own accounts, investments):
  /// transactions in such a category are left out of spending and income reports.
  countsAsSpending Boolean  @default(true) @map("counts_as_spending")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  merchants    Merchant[]
  transactions Transaction[]
  rules        CategoryRule[]

  @@map("categories")
}

/// Text fragment that, when contained in a merchant name, suggests a category.
/// Applies only while the merchant has no category of its own.
model CategoryRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Upper case, trimmed.
  pattern    String   @unique
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_rules")
}
