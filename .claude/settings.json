{
  "permissions": {
    "allow": [
      "Bash(yarn test:*)",
      "Bash(yarn typecheck:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn build:*)",
      "Bash(yarn test:db:*)",
      "Bash(yarn db:generate:*)",
      "Bash(docker compose exec app yarn test:*)",
      "Bash(docker compose exec app yarn typecheck:*)",
      "Bash(docker compose exec app yarn lint:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./statements/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
